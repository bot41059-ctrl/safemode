<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme -->
    <style name="Theme.SafeMode" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <!-- Fullscreen Red Alert Theme for Intruder Screen -->
    <style name="Theme.SafeMode.FullScreenAlert" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/bg_pure_black</item>
        <item name="android:navigationBarColor">@color/bg_pure_black</item>
        <item name="android:windowBackground">@color/bg_pure_black</item>
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
        <item name="android:keepScreenOn">true</item>
    </style>

    <!-- Table Guard Theme (Pitch Black Stealth Mode) -->
    <style name="Theme.SafeMode.TableGuard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/bg_pure_black</item>
        <item name="android:navigationBarColor">@color/bg_pure_black</item>
        <item name="android:windowBackground">@color/bg_pure_black</item>
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>
