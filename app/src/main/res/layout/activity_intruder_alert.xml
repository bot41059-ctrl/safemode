<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alertRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/accent_red_dark"
    android:keepScreenOn="true"
    android:padding="20dp">

    <!-- Silent Hidden Camera View for Intruder Snapshots -->
    <androidx.camera.view.PreviewView
        android:id="@+id/hiddenIntruderCamera"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0.01"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Flashing Warning Strobe Container -->
    <View
        android:id="@+id/viewStrobeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_red"
        android:visibility="visible" />

    <!-- Warning Icon -->
    <ImageView
        android:id="@+id/ivAlarmIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_warning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Alert Title -->
    <TextView
        android:id="@+id/tvAlarmHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:text="INTRUDER DETECTED!"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivAlarmIcon" />

    <!-- Warning Plan Message -->
    <TextView
        android:id="@+id/tvIntruderWarningMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:text="YOU THE FUCKING HELL MAN GO TO HELL"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAlarmHeader" />

    <TextView
        android:id="@+id/tvAlarmSubtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Intruder photo &amp; location captured and uploaded.\nEnter Owner PIN or scan owner face to stop."
        android:textColor="#FFEBEE"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvIntruderWarningMessage" />

    <!-- PIN Bypass Section -->
    <LinearLayout
        android:id="@+id/layoutPinEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="#D0000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY PIN BYPASS"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmergencyPin"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_cyber"
            android:gravity="center"
            android:hint="Enter 4-Digit PIN"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitPin"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_primary"
            android:text="DISARM ALARM"
            android:textColor="#0B0E14"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
