<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_cyber"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Captured Photo Thumbnail -->
    <ImageView
        android:id="@+id/ivIntruderThumb"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="#1E2638"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_camera" />

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogEventTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motion Triggered Alert"
            android:textColor="@color/accent_red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2026-10-31 18:45:00"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLogDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Battery: 78% | Face: Mismatch"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
